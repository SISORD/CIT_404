# --- Database -------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cit404

# --- Auth -----------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-before-the-event
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=1

# --- Server ---------------------------------------------------------
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5174,http://localhost:4173

# --- Seeding --------------------------------------------------------
SEED_TEAM_COUNT=12
SEED_STARTING_BALANCE=150
SEED_ADMIN_USER=core_admin
# Leave blank to have a random password generated and printed once.
SEED_ADMIN_PASSWORD=
